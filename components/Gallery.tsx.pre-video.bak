"use client";
import { useEffect, useMemo, useRef, useState } from "react";
import Image from "next/image";
import {
  ArrowDownRight,
  ArrowLeft,
  ArrowRight,
  ArrowUpRight,
  Play,
  X,
} from "lucide-react";
import gsap from "gsap";
import { ScrollTrigger } from "gsap/ScrollTrigger";
import { useGSAP } from "@gsap/react";
import SiteHeader from "@/components/SiteHeader";
import type { Photo } from "@/lib/photos";
import { categories } from "@/lib/collections";
import { videos } from "@/data/videos";
gsap.registerPlugin(useGSAP, ScrollTrigger);
export default function Gallery({ photos }: { photos: Photo[] }) {
  const [selected, setSelected] = useState("all");
  const [active, setActive] = useState<number | null>(null);
  const [video, setVideo] = useState<string | null>(null);
  const [showAll, setShowAll] = useState(false);
  const root = useRef<HTMLDivElement>(null);
  const filtered = useMemo(
    () =>
      selected === "all"
        ? photos
        : photos.filter((p) => p.category === selected),
    [photos, selected],
  );
  const visible = showAll ? filtered : filtered.slice(0, 48);
  const cover = photos.find((p) => p.category === "main-area") || photos[0];
  useGSAP(
    () => {
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      gsap.from(".hero-reveal", {
        y: 36,
        autoAlpha: 0,
        duration: 1,
        stagger: 0.14,
        ease: "power3.out",
      });
      gsap.utils
        .toArray<HTMLElement>(".reveal-section")
        .forEach((el) =>
          gsap.fromTo(
            el,
            { y: 35, autoAlpha: 0 },
            {
              y: 0,
              autoAlpha: 1,
              duration: 0.8,
              ease: "power2.out",
              scrollTrigger: { trigger: el, start: "top 90%", once: true },
            },
          ),
        );
    },
    { scope: root },
  );
  useGSAP(
    () => {
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      gsap.fromTo(
        ".photo-card",
        { y: 24, opacity: 0 },
        {
          y: 0,
          opacity: 1,
          duration: 0.6,
          stagger: 0.035,
          ease: "power2.out",
          clearProps: "all",
        },
      );
    },
    { scope: root, dependencies: [selected, showAll], revertOnUpdate: true },
  );
  useEffect(() => {
    setShowAll(false);
    setActive(null);
  }, [selected]);
  useEffect(() => {
    if (active === null && !video) return;
    const prev = document.body.style.overflow;
    document.body.style.overflow = "hidden";
    function onKey(e: KeyboardEvent) {
      if (e.key === "Escape") {
        setActive(null);
        setVideo(null);
      }
      if (active !== null && e.key === "ArrowRight")
        setActive((active + 1) % filtered.length);
      if (active !== null && e.key === "ArrowLeft")
        setActive((active - 1 + filtered.length) % filtered.length);
    }
    window.addEventListener("keydown", onKey);
    return () => {
      document.body.style.overflow = prev;
      window.removeEventListener("keydown", onKey);
    };
  }, [active, video, filtered]);
  const changeCategory = (id: string) => {
    setSelected(id);
    document
      .getElementById("collection")
      ?.scrollIntoView({ behavior: "smooth" });
  };
  return (
    <main ref={root}>
      <SiteHeader />
      <section className="hero" id="story">
        <div className="hero-photo">
          {cover ? (
            <Image
              src={cover.src}
              alt="Nyota Springs landscape and camp"
              fill
              priority
              sizes="100vw"
              style={{ objectFit: "cover" }}
            />
          ) : (
            <div className="hero-placeholder" />
          )}
        </div>
        <div className="hero-shade" />
        <div className="hero-body">
          <span className="eyebrow hero-reveal">
            A place to feel more alive <span className="line" />
          </span>
          <h1 className="hero-reveal">
            Some places
            <br />
            stay <em>with you.</em>
          </h1>
          <p className="hero-reveal">
            Welcome to a visual journey through Nyota Springs — where every stay
            is a story and every view stays a little longer.
          </p>
          <a href="#collection" className="hero-cta hero-reveal">
            Explore the gallery <ArrowDownRight size={20} />
          </a>
        </div>
        <span className="hero-index">01 / THE GALLERY</span>
        <span className="hero-scroll">SCROLL TO EXPLORE ↓</span>
      </section>
      <section className="intro reveal-section">
        <span className="eyebrow dark">THE NYOTA SPRINGS COLLECTION</span>
        <div>
          <h2>
            Wild at heart.
            <br />
            <em>Beautiful by nature.</em>
          </h2>
          <p>
            From slow mornings over breakfast to rooms made for dreaming,
            explore life at camp through the moments that make it unforgettable.
          </p>
        </div>
      </section>
      <section className="collection" id="collection">
        <div className="collection-heading reveal-section">
          <div>
            <span className="eyebrow dark">STORIES IN STILL FRAMES</span>
            <h2>
              Explore the <em>collection.</em>
            </h2>
          </div>
          <span className="collection-count">
            {filtered.length.toString().padStart(2, "0")} PHOTOGRAPHS
          </span>
        </div>
        <div className="filter-wrap">
          <button
            className={selected === "all" ? "filter active" : "filter"}
            onClick={() => changeCategory("all")}
          >
            All moments
          </button>
          {categories.map((c) => (
            <button
              key={c.id}
              className={selected === c.id ? "filter active" : "filter"}
              onClick={() => changeCategory(c.id)}
            >
              {c.title}
            </button>
          ))}
        </div>
        {selected !== "all" && (
          <div className="category-intro">
            <span className="eyebrow dark">
              THE COLLECTION / {selected.toUpperCase()}
            </span>
            <p>{categories.find((c) => c.id === selected)?.intro}</p>
          </div>
        )}
        <div className="masonry" key={selected}>
          {visible.map((photo, i) => (
            <button
              aria-label={`View ${photo.title}, photograph ${i + 1}`}
              className="photo-card"
              key={photo.id}
              onClick={() => setActive(i)}
            >
              <span
                className="photo-image"
                style={{ aspectRatio: `${photo.width}/${photo.height}` }}
              >
                <Image
                  src={photo.src}
                  alt={`${photo.title}, ${photo.filename}`}
                  fill
                  sizes="(max-width: 650px) 100vw, (max-width: 1000px) 50vw, 33vw"
                  loading={i < 3 ? "eager" : "lazy"}
                  quality={72}
                  style={{ objectFit: "cover" }}
                />
              </span>
              <span className="photo-meta">
                <span>{photo.title}</span>
                <ArrowUpRight size={17} />
              </span>
            </button>
          ))}
        </div>
        {filtered.length === 0 && (
          <div className="empty">
            <h3>Moments coming soon.</h3>
            <p>
              The photographs in this collection will appear here once their
              URLs are added or discovered through WordPress.
            </p>
          </div>
        )}
        {!showAll && filtered.length > 48 && (
          <button className="load-more" onClick={() => setShowAll(true)}>
            View all {filtered.length} photographs <ArrowDownRight size={18} />
          </button>
        )}
      </section>
      <section className="films" id="films">
        <div className="films-top reveal-section">
          <div>
            <span className="eyebrow">MOVEMENT & MEMORY</span>
            <h2>
              Beyond <em>the frame.</em>
            </h2>
          </div>
          <p>
            Some stories are better experienced in motion. Films from our world,
            coming together here.
          </p>
        </div>
        {videos.length ? (
          <div className="film-grid">
            {videos.map((v) => (
              <button
                className="film-card"
                key={v.id}
                onClick={() => setVideo(v.id)}
              >
                <Image
                  src={v.poster}
                  alt={v.title}
                  fill
                  sizes="(max-width: 700px) 100vw, 50vw"
                  style={{ objectFit: "cover" }}
                />
                <span className="play">
                  <Play fill="currentColor" size={20} />
                </span>
                <span className="film-label">{v.title}</span>
              </button>
            ))}
          </div>
        ) : (
          <div className="film-placeholder">
            <span className="circle-play">
              <Play size={23} />
            </span>
            <div>
              <span className="eyebrow">THE FILM COLLECTION</span>
              <p>
                Ten moments in motion.
                <br />
                Coming soon.
              </p>
            </div>
            <span>01 — 10</span>
          </div>
        )}
      </section>
      <footer>
        <div>
          <span className="eyebrow dark">THE JOURNEY BEGINS HERE</span>
          <h2>
            Come for the views.
            <br />
            <em>Stay for the feeling.</em>
          </h2>
          <a href="https://nyotasprings.com" className="footer-link">
            Explore Nyota Springs <ArrowUpRight size={20} />
          </a>
        </div>
        <div className="footer-bottom">
          <span>✳ NYOTA SPRINGS</span>
          <span>GALLERY • PHOTOGRAPHIC STORIES</span>
          <span>© {new Date().getFullYear()} NYOTA SPRINGS</span>
        </div>
      </footer>
      {active !== null && filtered[active] && (
        <div
          className="lightbox"
          role="dialog"
          aria-modal="true"
          aria-label="Photo viewer"
          onClick={() => setActive(null)}
        >
          <div className="lightbox-top">
            <span>
              {filtered[active].title} · {active + 1} / {filtered.length}
            </span>
            <button
              aria-label="Close photo viewer"
              onClick={() => setActive(null)}
            >
              <X />
            </button>
          </div>
          <button
            className="lightbox-arrow left"
            aria-label="Previous photograph"
            onClick={(e) => {
              e.stopPropagation();
              setActive((active - 1 + filtered.length) % filtered.length);
            }}
          >
            <ArrowLeft />
          </button>
          <div className="lightbox-image" onClick={(e) => e.stopPropagation()}>
            <Image
              src={filtered[active].src}
              alt={filtered[active].title}
              fill
              sizes="100vw"
              quality={85}
              style={{ objectFit: "contain" }}
            />
          </div>
          <button
            className="lightbox-arrow right"
            aria-label="Next photograph"
            onClick={(e) => {
              e.stopPropagation();
              setActive((active + 1) % filtered.length);
            }}
          >
            <ArrowRight />
          </button>
        </div>
      )}
      {video && videos.find((v) => v.id === video) && (
        <div
          className="lightbox"
          role="dialog"
          aria-modal="true"
          aria-label="Video viewer"
        >
          <div className="lightbox-top">
            <span>NYOTA SPRINGS FILMS</span>
            <button aria-label="Close video" onClick={() => setVideo(null)}>
              <X />
            </button>
          </div>
          <video
            className="video-player"
            src={videos.find((v) => v.id === video)?.src}
            controls
            autoPlay
            playsInline
            preload="none"
          />
        </div>
      )}
    </main>
  );
}
